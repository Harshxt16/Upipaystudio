rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUtrId(utr) {
      return utr is string && utr.size() == 12 && utr.matches('^[0-9]{12}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminToken() {
      return isVerifiedUser() && request.auth.token.email == 'autoclipping1@gmail.com';
    }

    function isAdmin() {
      return isAdminToken() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---
    function isValidGatewayConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll(['upiId', 'payeeName', 'accentColor'])
        && cfg.keys().hasOnly([
          'upiId',
          'payeeName',
          'adminPin',
          'accentColor',
          'redirectUrl',
          'staticQrDataUrl',
          'deliveryEmail',
          'deliveryPreference',
          'configuredAt'
        ])
        && cfg.upiId is string && cfg.upiId.size() >= 3 && cfg.upiId.size() <= 256
        && cfg.payeeName is string && cfg.payeeName.size() >= 2 && cfg.payeeName.size() <= 120
        && cfg.accentColor is string && cfg.accentColor.size() >= 4 && cfg.accentColor.size() <= 20
        && (!('adminPin' in cfg) || (cfg.adminPin is string && cfg.adminPin.size() >= 4 && cfg.adminPin.size() <= 64))
        && (!('redirectUrl' in cfg) || (cfg.redirectUrl is string && cfg.redirectUrl.size() <= 500))
        && (!('staticQrDataUrl' in cfg) || (cfg.staticQrDataUrl is string && cfg.staticQrDataUrl.size() <= 500000))
        && (!('deliveryEmail' in cfg) || (cfg.deliveryEmail is string && cfg.deliveryEmail.size() <= 254))
        && (!('deliveryPreference' in cfg) || (cfg.deliveryPreference is string && cfg.deliveryPreference.size() <= 64))
        && (!('configuredAt' in cfg) || (cfg.configuredAt is string && cfg.configuredAt.size() <= 64));
    }

    function isValidClientAccount(data, clientId) {
      return data.keys().hasAll([
          'id',
          'uid',
          'merchantCode',
          'slug',
          'fullName',
          'entityName',
          'email',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'merchantCode',
          'slug',
          'fullName',
          'entityName',
          'email',
          'status',
          'gatewayConfig',
          'activationUtr',
          'activationSubmittedAt',
          'activatedAt',
          'rejectedReason',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == clientId && isValidId(data.id)
        && data.uid is string && data.uid == clientId && isValidId(data.uid)
        && data.merchantCode is string && data.merchantCode.size() >= 3 && data.merchantCode.size() <= 32 && data.merchantCode.matches('^[A-Z0-9]+$')
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.entityName is string && data.entityName.size() >= 2 && data.entityName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.status in ['UNPAID', 'PENDING_VERIFICATION', 'ACTIVE', 'REJECTED']
        && (!('gatewayConfig' in data) || data.gatewayConfig == null || isValidGatewayConfig(data.gatewayConfig))
        && (!('activationUtr' in data) || isValidUtrId(data.activationUtr))
        && (!('activationSubmittedAt' in data) || (data.activationSubmittedAt is string && data.activationSubmittedAt.size() <= 64))
        && (!('activatedAt' in data) || (data.activatedAt is string && data.activatedAt.size() <= 64))
        && (!('rejectedReason' in data) || (data.rejectedReason is string && data.rejectedReason.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerOrder(data, orderDocId) {
      return data.keys().hasAll([
          'id',
          'clientId',
          'clientSlug',
          'orderId',
          'amount',
          'utr',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'clientId',
          'clientSlug',
          'orderId',
          'amount',
          'utr',
          'customerName',
          'customerNote',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == orderDocId && isValidId(data.id)
        && data.clientId is string && isValidId(data.clientId)
        && data.clientSlug is string && data.clientSlug.size() >= 1 && data.clientSlug.size() <= 100 && data.clientSlug.matches('^[a-z0-9\\-]+$')
        && data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 64
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && data.utr is string && data.utr.size() >= 4 && data.utr.size() <= 32
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
        && (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 240))
        && data.status in ['PENDING_VERIFICATION', 'APPROVED', 'REJECTED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsedUtr(data, utrId) {
      return data.keys().hasAll(['utr', 'clientId', 'amount', 'activatedAt', 'createdAt'])
        && data.keys().hasOnly(['utr', 'clientId', 'amount', 'activatedAt', 'createdAt'])
        && isValidUtrId(data.utr) && data.utr == utrId
        && data.clientId is string && isValidId(data.clientId)
        && data.amount is number && data.amount == 1
        && data.activatedAt is string && data.activatedAt.size() >= 10 && data.activatedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidFamPayAlert(data, alertId) {
      return data.keys().hasAll([
          'utr',
          'amount',
          'sender_email',
          'raw_subject',
          'received_at',
          'matched',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'utr',
          'amount',
          'sender_email',
          'raw_subject',
          'received_at',
          'matched',
          'matchedClientId',
          'matchedAt',
          'createdAt'
        ])
        && isValidUtrId(data.utr) && data.utr == alertId
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && data.sender_email is string && data.sender_email.size() >= 1 && data.sender_email.size() <= 254
        && data.raw_subject is string && data.raw_subject.size() >= 1 && data.raw_subject.size() <= 300
        && data.received_at is string && data.received_at.size() >= 10 && data.received_at.size() <= 64
        && data.matched is bool
        && (!('matchedClientId' in data) || isValidId(data.matchedClientId))
        && (!('matchedAt' in data) || (data.matchedAt is string && data.matchedAt.size() <= 64))
        && data.createdAt is timestamp;
    }

    function isValidSyncConfig(data, settingId) {
      return data.keys().hasAll(['id', 'notificationEmail', 'vercelAppUrl', 'updatedAt'])
        && data.keys().hasOnly(['id', 'notificationEmail', 'vercelAppUrl', 'updatedAt'])
        && data.id is string && data.id == settingId && isValidId(data.id)
        && data.notificationEmail is string && data.notificationEmail.size() <= 254
        && data.vercelAppUrl is string && data.vercelAppUrl.size() <= 500
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connectivity probe document (single read-only non-PII doc)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Platform Owner Admins
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdminToken();
      allow create, update, delete: if false;
    }

    // Admin-only Sync Settings
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isAdminToken();
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidSyncConfig(incoming(), settingId)
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidSyncConfig(incoming(), settingId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'notificationEmail',
          'vercelAppUrl',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Immutable Anti-Fraud Registry of Used ₹1 Activation UTRs
    match /used_utrs/{utrId} {
      allow get: if isValidUtrId(utrId) && isSignedIn();
      allow list: if isAdminToken();
      allow create: if isSignedIn()
        && isValidUtrId(utrId)
        && isValidUsedUtr(incoming(), utrId)
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (
            incoming().clientId == request.auth.uid
            && incoming().amount == 1
            && get(/databases/$(database)/documents/fampay_alerts/$(utrId)).data.amount == 1
            && get(/databases/$(database)/documents/fampay_alerts/$(utrId)).data.matched == false
            && get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status != 'ACTIVE'
            && getAfter(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status == 'ACTIVE'
            && getAfter(/databases/$(database)/documents/clients/$(request.auth.uid)).data.activationUtr == utrId
          )
        );
      allow update, delete: if false;
    }

    // FamPay Alerts for Automated ₹1 UTR Verification
    match /fampay_alerts/{alertId} {
      allow get: if isValidUtrId(alertId) && (
        isAdmin()
        || (
          isSignedIn()
          && (
            resource == null
            || existing().matched == false
            || existing().matchedClientId == request.auth.uid
          )
        )
      );
      allow list: if isAdminToken();
      allow create: if isAdmin()
        && isValidUtrId(alertId)
        && isValidFamPayAlert(incoming(), alertId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidUtrId(alertId)
        && isValidFamPayAlert(incoming(), alertId)
        && incoming().utr == existing().utr
        && incoming().amount == existing().amount
        && incoming().sender_email == existing().sender_email
        && incoming().raw_subject == existing().raw_subject
        && incoming().received_at == existing().received_at
        && incoming().createdAt == existing().createdAt
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'matched',
              'matchedClientId',
              'matchedAt'
            ])
          )
          || (
            existing().amount == 1
            && existing().matched == false
            && incoming().matched == true
            && ('matchedClientId' in incoming())
            && incoming().matchedClientId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'matched',
              'matchedClientId',
              'matchedAt'
            ])
            && existsAfter(/databases/$(database)/documents/used_utrs/$(alertId))
            && get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status != 'ACTIVE'
            && getAfter(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status == 'ACTIVE'
            && getAfter(/databases/$(database)/documents/clients/$(request.auth.uid)).data.activationUtr == alertId
          )
        );
      allow delete: if false;
    }

    // Merchant Client Accounts (PII-isolated to owner or verified platform admin)
    match /clients/{clientId} {
      allow get: if isValidId(clientId) && (isOwner(clientId) || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && existing().uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(clientId)
        && isValidClientAccount(incoming(), clientId)
        && isOwner(clientId)
        && incoming().uid == request.auth.uid
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().status == 'UNPAID'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(clientId)
        && isValidClientAccount(incoming(), clientId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().merchantCode == existing().merchantCode
        && incoming().slug == existing().slug
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin Verification (Approve or Reject ₹1 Activation)
          (
            isAdmin()
            && incoming().status in ['ACTIVE', 'REJECTED', 'PENDING_VERIFICATION']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'activatedAt',
              'rejectedReason',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Owner updates Gateway Setup (UPI ID, Payee Name, Brand Color, etc.)
          (
            isOwner(clientId)
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'gatewayConfig',
              'updatedAt'
            ])
          )
          ||
          // Action 3: Owner submits unused 12-digit ₹1 Activation UTR (blocked once terminal ACTIVE)
          (
            isOwner(clientId)
            && existing().status != 'ACTIVE'
            && incoming().status == 'PENDING_VERIFICATION'
            && ('activationUtr' in incoming())
            && isValidUtrId(incoming().activationUtr)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'activationUtr',
              'activationSubmittedAt',
              'status',
              'rejectedReason',
              'updatedAt'
            ])
            && !exists(/databases/$(database)/documents/used_utrs/$(incoming().activationUtr))
          )
          ||
          // Action 4: Instant Atomic Auto-Confirmation via Verified Unmatched ₹1 FamPay Alert
          (
            isOwner(clientId)
            && existing().status != 'ACTIVE'
            && incoming().status == 'ACTIVE'
            && ('activationUtr' in incoming())
            && isValidUtrId(incoming().activationUtr)
            && ('activatedAt' in incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'activationUtr',
              'activationSubmittedAt',
              'activatedAt',
              'status',
              'rejectedReason',
              'updatedAt'
            ])
            && !exists(/databases/$(database)/documents/used_utrs/$(incoming().activationUtr))
            && get(/databases/$(database)/documents/fampay_alerts/$(incoming().activationUtr)).data.amount == 1
            && get(/databases/$(database)/documents/fampay_alerts/$(incoming().activationUtr)).data.matched == false
            && existsAfter(/databases/$(database)/documents/used_utrs/$(incoming().activationUtr))
            && getAfter(/databases/$(database)/documents/fampay_alerts/$(incoming().activationUtr)).data.matched == true
            && getAfter(/databases/$(database)/documents/fampay_alerts/$(incoming().activationUtr)).data.matchedClientId == clientId
          )
        );

      allow delete: if false;
    }

    // Customer Orders (Scoped to parent merchant owner or admin)
    match /orders/{orderDocId} {
      allow get: if isValidId(orderDocId) && (
        (isSignedIn() && existing().clientId == request.auth.uid) || isAdmin()
      );
      allow list: if isAdminToken() || (isSignedIn() && existing().clientId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(orderDocId)
        && isValidCustomerOrder(incoming(), orderDocId)
        && incoming().status == 'PENDING_VERIFICATION'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId));

      allow update: if isSignedIn()
        && isValidId(orderDocId)
        && isValidCustomerOrder(incoming(), orderDocId)
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().clientSlug == existing().clientSlug
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().clientId == request.auth.uid
            && existing().status == 'PENDING_VERIFICATION'
            && incoming().status in ['APPROVED', 'REJECTED']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;
    }
  }
}
